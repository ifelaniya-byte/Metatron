# Remote worker configuration
# The scheduled daycare is active by default; set this to true to pause it.
METATRON_DISABLE_DAYCARE=false
METATRON_DAYCARE_ROOT=/var/lib/metatron/daycare

# Self-hosted GPU runner label. Empty/unset => GitHub-hosted CPU runner,
# which performs a fast "nano" smoke cycle.
METATRON_RUNNER=
# METATRON_RUNNER=metatron-gpu

# Model scale: nano (CPU smoke), ultra, tiny, small, medium (GPU).
METATRON_SCALE=nano

# Training budget for one cycle (adaptive; cheap experiments first).
METATRON_MAX_BUDGET=50
# Minimum benchmark gain (negative eval-loss units) required for promotion.
METATRON_MIN_GAIN=0.002

# Conservative optimizer clamp; relax only after the benchmark proves it.
METATRON_SAFE_LR=0.0008
METATRON_GRAD_CLIP=0.5
METATRON_IDLE_SECONDS=60

# Optional frontier teacher (Anthropic-shaped API) and OpenAI-compatible
# teacher rotation. Teacher output is proposal-only; nothing is accepted
# without passing the executable benchmark gate.
# ANTHROPIC_API_KEY=
# METATRON_FRONTIER_MODEL=claude-fable-5-1
# METATRON_TEACHERS=[{"base_url":"https://provider.example/v1","api_key_env":"PROVIDER_KEY","model":"model-name"}]
